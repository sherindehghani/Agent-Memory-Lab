# Copy to .env and adjust. All variables are optional.

# SQLite database (default: data/lab.db in the project root)
# LAB_DATABASE_URL=sqlite:////absolute/path/to/lab.db
# Experiment workspace (contains its own Git repository; default: ./workspace)
# LAB_WORKSPACE_DIR=/absolute/path/to/workspace

# Reproducibility and acceptance rule
LAB_RANDOM_SEED=42
LAB_ACCEPTANCE_THRESHOLD=0.001

# Run budgets (safe defaults)
LAB_MAX_EXPERIMENTS=5
LAB_MAX_RUN_SECONDS=600
LAB_MAX_RETRIES=1
LAB_EXPERIMENT_TIMEOUT_SECONDS=120

# subprocess = hard timeouts and stop requests terminate training; inprocess = faster, used by tests
LAB_EXECUTION_MODE=subprocess

# Optional LLM planner (requires: pip install -r backend/requirements-llm.txt)
LAB_LLM_PROVIDER=none
# LAB_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

LAB_LOG_LEVEL=INFO
LAB_LOG_JSON=true
