LAB_RANDOM_SEED=42
LAB_ACCEPTANCE_THRESHOLD=0.001

LAB_MAX_EXPERIMENTS=5
LAB_MAX_RUN_SECONDS=600
LAB_MAX_RETRIES=1
LAB_EXPERIMENT_TIMEOUT_SECONDS=120
# Per-attempt time limit in autoresearch mode (the article's fixed training budget)
LAB_AUTORESEARCH_RUN_TIMEOUT_SECONDS=120

LAB_EXECUTION_MODE=subprocess

LAB_LLM_PROVIDER=none

LAB_LOG_LEVEL=INFO
LAB_LOG_JSON=true

LAB_ENVIRONMENT=development
# SQLite by default; set a PostgreSQL URL for multi-user / production deployments:
# LAB_DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
LAB_DB_POOL_SIZE=10
LAB_DB_MAX_OVERFLOW=20
